<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MHBank.Mobile.Views.ChangePasswordPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F5F5F5">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Header -->
            <HorizontalStackLayout Spacing="10" Margin="0,20,0,0">
                <Label Text="←"
                       FontSize="24"
                       TextColor="Black">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped" />
                    </Label.GestureRecognizers>
                </Label>
                <Label Text="تغيير كلمة المرور"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="Black"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>

            <!-- Current Password -->
            <Label Text="كلمة المرور الحالية:"
                   FontSize="14"
                   TextColor="Gray"
                   Margin="5,10,0,5" />
            <Border Stroke="LightGray"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 12"
                    BackgroundColor="White">
                <Entry x:Name="CurrentPasswordEntry"
                       Placeholder="أدخل كلمة المرور الحالية"
                       IsPassword="True"
                       PlaceholderColor="Gray"
                       TextColor="Black"
                       BackgroundColor="Transparent"
                       Margin="10,0" />
            </Border>

            <!-- New Password -->
            <Label Text="كلمة المرور الجديدة:"
                   FontSize="14"
                   TextColor="Gray"
                   Margin="5,10,0,5" />
            <Border Stroke="LightGray"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 12"
                    BackgroundColor="White">
                <Entry x:Name="NewPasswordEntry"
                       Placeholder="أدخل كلمة المرور الجديدة"
                       IsPassword="True"
                       PlaceholderColor="Gray"
                       TextColor="Black"
                       BackgroundColor="Transparent"
                       Margin="10,0" />
            </Border>

            <!-- Confirm Password -->
            <Label Text="تأكيد كلمة المرور:"
                   FontSize="14"
                   TextColor="Gray"
                   Margin="5,10,0,5" />
            <Border Stroke="LightGray"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 12"
                    BackgroundColor="White">
                <Entry x:Name="ConfirmPasswordEntry"
                       Placeholder="أعد إدخال كلمة المرور الجديدة"
                       IsPassword="True"
                       PlaceholderColor="Gray"
                       TextColor="Black"
                       BackgroundColor="Transparent"
                       Margin="10,0" />
            </Border>

            <!-- Password Requirements -->
            <Border BackgroundColor="#FFF3CD"
                    StrokeThickness="0"
                    Padding="15"
                    StrokeShape="RoundRectangle 12"
                    Margin="0,10,0,0">
                <VerticalStackLayout Spacing="5">
                    <Label Text="متطلبات كلمة المرور:"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="#856404" />
                    <Label Text="• لا تقل عن 6 أحرف"
                           FontSize="12"
                           TextColor="#856404" />
                    <Label Text="• تحتوي على حروف وأرقام"
                           FontSize="12"
                           TextColor="#856404" />
                    <Label Text="• تجنب استخدام معلومات شخصية"
                           FontSize="12"
                           TextColor="#856404" />
                </VerticalStackLayout>
            </Border>

            <!-- Change Password Button -->
            <Button x:Name="ChangePasswordButton"
                    Text="تغيير كلمة المرور 🔒"
                    Style="{StaticResource PrimaryButton}"
                    Clicked="OnChangePasswordClicked"
                    Margin="0,20,0,0" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
