<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MHBank.Mobile.Views.HomePage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F5F5F5">

    <Grid>
        <!-- Loading Indicator -->
        <Label x:Name="LoadingLabel"
               Text="جاري التحميل..."
               FontSize="18"
               TextColor="Gray"
               HorizontalOptions="Center"
               VerticalOptions="Center"
               IsVisible="true" />

        <!-- Main Content -->
        <ScrollView x:Name="ContentLayout" IsVisible="false">
            <VerticalStackLayout Spacing="0">

                <!-- Header -->
                <Grid BackgroundColor="White" 
                      Padding="20,50,20,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Label Text="☰"
                           FontSize="24"
                           TextColor="Black"
                           VerticalOptions="Center" />

                    <Label Grid.Column="1"
                           Text="MH Bank"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="Black"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />

                    <HorizontalStackLayout Grid.Column="2" Spacing="15">
                        <!-- زر + -->
                        <Border BackgroundColor="#4A90E2"
                                StrokeThickness="0"
                                WidthRequest="35"
                                HeightRequest="35"
                                VerticalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="17.5" />
                            </Border.StrokeShape>
                            <Label Text="+"
                                   FontSize="22"
                                   FontAttributes="Bold"
                                   TextColor="White"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnAddButtonTapped" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Border>

                        <Label Text="👤"
                               FontSize="24"
                               VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnProfileTapped" />
                            </Label.GestureRecognizers>
                        </Label>

                        <!-- Notification Bell with Badge -->
                        <Grid WidthRequest="30" HeightRequest="30">
                            <Label Text="🔔"
                                   FontSize="24"
                                   VerticalOptions="Center"
                                   HorizontalOptions="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnNotificationsTapped" />
                                </Label.GestureRecognizers>
                            </Label>

                            <!-- Notification Badge -->
                            <Border x:Name="NotificationBadge"
                                    BackgroundColor="#F44336"
                                    WidthRequest="18"
                                    HeightRequest="18"
                                    HorizontalOptions="End"
                                    VerticalOptions="Start"
                                    Margin="0,-2,-2,0"
                                    StrokeThickness="0"
                                    IsVisible="False"
                                    StrokeShape="RoundRectangle 9">
                                <Label x:Name="NotificationCount"
                                       Text="3"
                                       FontSize="10"
                                       FontAttributes="Bold"
                                       TextColor="White"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                        </Grid>
                    </HorizontalStackLayout>
                </Grid>

                <!-- Content -->
                <VerticalStackLayout Padding="20" Spacing="20">

                    <!-- Welcome -->
                    <Label x:Name="WelcomeLabel"
                           Text="مرحباً 👋"
                           FontSize="26"
                           FontAttributes="Bold"
                           TextColor="Black" />

                    <!-- Balance Card -->
                    <Border BackgroundColor="#87CEEB"
                            StrokeThickness="0"
                            Padding="25"
                            HeightRequest="200"
                            Margin="0,10,0,0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="Black"
                                    Offset="0,4"
                                    Radius="10"
                                    Opacity="0.2" />
                        </Border.Shadow>

                        <Grid RowDefinitions="Auto,*,Auto,Auto">

                            <HorizontalStackLayout Spacing="8">
                                <Label Text="💰"
                                       FontSize="20"
                                       VerticalOptions="Center" />
                                <Label Text="الرصيد الكلي"
                                       FontSize="16"
                                       TextColor="Black"
                                       VerticalOptions="Center"
                                       Opacity="0.9"
                                       HorizontalOptions="Start" />
                                <Picker x:Name="AccountPicker"
                                        Title="كل الحسابات"
                                        FontSize="12"
                                        TextColor="Black"
                                        HorizontalOptions="End"
                                        SelectedIndexChanged="OnAccountSelected"
                                        WidthRequest="150" />
                            </HorizontalStackLayout>

                            <Label x:Name="TotalBalanceLabel"
                                   Grid.Row="1"
                                   Text="0 IQD"
                                   FontSize="38"
                                   FontAttributes="Bold"
                                   TextColor="Black"
                                   VerticalOptions="Center" />

                            <!-- Quick Actions -->
                            <Grid Grid.Row="2" 
                                  ColumnDefinitions="*,*,*,*" 
                                  ColumnSpacing="10">

                                <!-- Transfer -->
                                <Border Grid.Column="0"
                                        BackgroundColor="White"
                                        StrokeThickness="0"
                                        Padding="10,8">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnTransferTapped" />
                                    </Border.GestureRecognizers>
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="↗️"
                                               FontSize="20"
                                               HorizontalOptions="Center" />
                                        <Label Text="حوّل"
                                               FontSize="12"
                                               FontAttributes="Bold"
                                               TextColor="Black"
                                               HorizontalOptions="Center" />
                                    </VerticalStackLayout>
                                </Border>

                                <!-- Deposit -->
                                <Border Grid.Column="1"
                                        BackgroundColor="White"
                                        StrokeThickness="0"
                                        Padding="10,8">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnDepositTapped" />
                                    </Border.GestureRecognizers>
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="⬇️"
                                               FontSize="20"
                                               HorizontalOptions="Center" />
                                        <Label Text="إيداع"
                                               FontSize="12"
                                               FontAttributes="Bold"
                                               TextColor="Black"
                                               HorizontalOptions="Center" />
                                    </VerticalStackLayout>
                                </Border>

                                <!-- Bill Payment -->
                                <Border Grid.Column="2"
                                        BackgroundColor="White"
                                        StrokeThickness="0"
                                        Padding="10,8">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnBillPaymentTapped" />
                                    </Border.GestureRecognizers>
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="🧾"
                                               FontSize="20"
                                               HorizontalOptions="Center" />
                                        <Label Text="فواتير"
                                               FontSize="12"
                                               FontAttributes="Bold"
                                               TextColor="Black"
                                               HorizontalOptions="Center" />
                                    </VerticalStackLayout>
                                </Border>

                                <!-- KYC -->
                                <Border Grid.Column="3"
                                        BackgroundColor="White"
                                        StrokeThickness="0"
                                        Padding="10,8">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnKYCTapped" />
                                    </Border.GestureRecognizers>
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="📄"
                                               FontSize="20"
                                               HorizontalOptions="Center" />
                                        <Label Text="توثيق"
                                               FontSize="12"
                                               FontAttributes="Bold"
                                               TextColor="Black"
                                               HorizontalOptions="Center" />
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>

                            <!-- Second Row - Cards Button -->
                            <Border Grid.Row="3"
                                    BackgroundColor="White"
                                    StrokeThickness="0"
                                    Padding="15"
                                    Margin="0,10,0,0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnCardsTapped" />
                                </Border.GestureRecognizers>
                                <HorizontalStackLayout Spacing="15">
                                    <Label Text="💳"
                                           FontSize="24"
                                           VerticalOptions="Center" />
                                    <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                        <Label Text="بطاقاتي"
                                               FontSize="16"
                                               FontAttributes="Bold"
                                               TextColor="Black" />
                                        <Label Text="إدارة البطاقات المصرفية"
                                               FontSize="12"
                                               TextColor="Gray" />
                                    </VerticalStackLayout>
                                    <Label Text="←"
                                           FontSize="20"
                                           TextColor="Gray"
                                           HorizontalOptions="End"
                                           VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- My Accounts Section -->
                    <HorizontalStackLayout Spacing="10" Margin="0,10,0,5">
                        <Label Text="📊"
                               FontSize="22"
                               VerticalOptions="Center" />
                        <Label Text="حساباتي"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="Black"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <!-- Accounts Container -->
                    <VerticalStackLayout x:Name="AccountsLayout" />

                    <!-- Recent Transactions Section -->
                    <Grid Margin="0,10,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <HorizontalStackLayout Grid.Column="0" Spacing="10">
                            <Label Text="📜"
                                   FontSize="22"
                                   VerticalOptions="Center" />
                            <Label Text="آخر المعاملات"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   TextColor="Black"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <Label Grid.Column="1"
                               Text="المزيد ←"
                               FontSize="14"
                               TextColor="#87CEEB"
                               VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnViewAllTransactionsTapped" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>

                    <!-- Transactions Container -->
                    <ScrollView MaximumHeightRequest="400" Margin="0,0,0,20">
                        <VerticalStackLayout x:Name="TransactionsLayout" />
                    </ScrollView>

                    <!-- Logout Button -->
                    <Button Text="تسجيل الخروج"
                            BackgroundColor="#87CEEB"
                            TextColor="Black"
                            FontSize="16"
                            FontAttributes="Bold"
                            CornerRadius="12"
                            Clicked="OnLogoutClicked"
                            Margin="0,20,0,100" />

                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
