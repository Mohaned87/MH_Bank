<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MHBank.Mobile.Views.ProfilePage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F5F5F5">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Header -->
            <HorizontalStackLayout Spacing="10" Margin="0,20,0,0">
                <Label Text="←"
                       FontSize="24"
                       TextColor="Black">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped" />
                    </Label.GestureRecognizers>
                </Label>
                <Label Text="الملف الشخصي"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="Black"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>

            <!-- Profile Header -->
            <Border BackgroundColor="#87CEEB"
                    StrokeThickness="0"
                    Padding="25"
                    Margin="0,10,0,0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                    <Border BackgroundColor="White"
                            StrokeThickness="3"
                            Stroke="#87CEEB"
                            WidthRequest="80"
                            HeightRequest="80"
                            StrokeShape="RoundRectangle 40">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnProfilePictureTapped" />
                        </Border.GestureRecognizers>
                        <Grid>
                            <Label x:Name="ProfilePlaceholder"
                                   Text="📷"
                                   FontSize="40"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                            <Image x:Name="ProfileImage"
                                   Aspect="AspectFill"
                                   IsVisible="False" />
                        </Grid>
                    </Border>

                    <Label x:Name="FullNameLabel"
                           Text=""
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="Black"
                           HorizontalOptions="Center" />

                    <Label x:Name="EmailLabel"
                           Text=""
                           FontSize="14"
                           TextColor="Black"
                           Opacity="0.8"
                           HorizontalOptions="Center" />

                    <Label Text="اضغط على الصورة لتغييرها"
                           FontSize="11"
                           TextColor="#87CEEB"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- Personal Information -->
            <Border BackgroundColor="White"
                    StrokeThickness="0"
                    Padding="20"
                    StrokeShape="RoundRectangle 16">
                <VerticalStackLayout Spacing="15">
                    <Label Text="المعلومات الشخصية"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="Black" />

                    <!-- Email -->
                    <HorizontalStackLayout Spacing="12">
                        <Label Text="📧"
                               FontSize="20"
                               VerticalOptions="Start" />
                        <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                            <Label Text="البريد الإلكتروني"
                                   TextColor="Gray"
                                   FontSize="12" />
                            <Label x:Name="EmailValueLabel"
                                   Text=""
                                   TextColor="Black"
                                   FontSize="14" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>

                    <BoxView HeightRequest="1" Color="#E8E8E8" />

                    <!-- Phone -->
                    <HorizontalStackLayout Spacing="12">
                        <Label Text="📱"
                               FontSize="20"
                               VerticalOptions="Start" />
                        <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                            <Label Text="رقم الهاتف"
                                   TextColor="Gray"
                                   FontSize="12" />
                            <Label x:Name="PhoneLabel"
                                   Text=""
                                   TextColor="Black"
                                   FontSize="14" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>

                    <BoxView HeightRequest="1" Color="#E8E8E8" />

                    <!-- Join Date -->
                    <HorizontalStackLayout Spacing="12">
                        <Label Text="📅"
                               FontSize="20"
                               VerticalOptions="Start" />
                        <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                            <Label Text="تاريخ التسجيل"
                                   TextColor="Gray"
                                   FontSize="12" />
                            <Label x:Name="JoinDateLabel"
                                   Text=""
                                   TextColor="Black"
                                   FontSize="14" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Security Settings -->
            <Border BackgroundColor="White"
                    StrokeThickness="0"
                    Padding="20"
                    StrokeShape="RoundRectangle 16">
                <VerticalStackLayout Spacing="15">
                    <Label Text="إعدادات الأمان"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="Black" />

                    <!-- 2FA Toggle -->
                    <Grid ColumnDefinitions="*,Auto">
                        <HorizontalStackLayout Grid.Column="0" Spacing="10">
                            <Label Text="🔐"
                                   FontSize="20"
                                   VerticalOptions="Center" />
                            <VerticalStackLayout Spacing="2">
                                <Label Text="المصادقة الثنائية (2FA)"
                                       FontSize="16"
                                       TextColor="Black" />
                                <Label Text="حماية إضافية لحسابك"
                                       FontSize="12"
                                       TextColor="Gray" />
                            </VerticalStackLayout>
                        </HorizontalStackLayout>

                        <Switch x:Name="TwoFactorSwitch"
                                Grid.Column="1"
                                IsToggled="False"
                                OnColor="#87CEEB"
                                Toggled="OnTwoFactorToggled" />
                    </Grid>

                    <!-- Change Password Button -->
                    <Border BackgroundColor="#F5F5F5"
                            StrokeThickness="0"
                            Padding="15"
                            StrokeShape="RoundRectangle 12">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnChangePasswordTapped" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="10">
                            <Label Text="🔑"
                                   FontSize="20"
                                   VerticalOptions="Center" />
                            <Label Text="تغيير كلمة المرور"
                                   FontSize="16"
                                   TextColor="Black"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- App Settings -->
            <Border BackgroundColor="White"
                    StrokeThickness="0"
                    Padding="20"
                    StrokeShape="RoundRectangle 16">
                <VerticalStackLayout Spacing="15">
                    <Label Text="الإعدادات"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="Black" />

                    <!-- Server Settings -->
                    <Border BackgroundColor="#F5F5F5"
                            StrokeThickness="0"
                            Padding="15"
                            StrokeShape="RoundRectangle 12">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSettingsTapped" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="10">
                            <Label Text="🔌"
                                   FontSize="20"
                                   VerticalOptions="Center" />
                            <Label Text="إعدادات الاتصال"
                                   FontSize="16"
                                   TextColor="Black"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>

                    <Border BackgroundColor="#F5F5F5"
                            StrokeThickness="0"
                            Padding="15"
                            StrokeShape="RoundRectangle 12">
                        <HorizontalStackLayout Spacing="10">
                            <Label Text="🌙"
                                   FontSize="20"
                                   VerticalOptions="Center" />
                            <Label Text="الوضع الليلي"
                                   FontSize="16"
                                   TextColor="Black"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>

                    <Border BackgroundColor="#F5F5F5"
                            StrokeThickness="0"
                            Padding="15"
                            StrokeShape="RoundRectangle 12">
                        <HorizontalStackLayout Spacing="10">
                            <Label Text="🔔"
                                   FontSize="20"
                                   VerticalOptions="Center" />
                            <Label Text="الإشعارات"
                                   FontSize="16"
                                   TextColor="Black"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- Logout Button -->
            <Button Text="تسجيل الخروج"
                    BackgroundColor="#F44336"
                    TextColor="White"
                    FontSize="16"
                    FontAttributes="Bold"
                    CornerRadius="12"
                    Clicked="OnLogoutClicked"
                    Margin="0,20,0,40" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
